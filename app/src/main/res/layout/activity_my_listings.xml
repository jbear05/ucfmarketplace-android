                            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/km_edit" android:contentDescription="Edit" app:tint="@color/km_muted" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:textSize="12sp" android:textColor="@color/km_muted" android:layout_marginStart="6dp" />
