                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/km_card" android:layout_marginBottom="12dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp">
                        <LinearLayout android:layout_width="72dp" android:layout_height="72dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/km_photo_placeholder">
                            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/km_camera" android:contentDescription="Listing photo placeholder" app:tint="@color/km_muted" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
