<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/main" android:tag="reference_full_width" android:background="@color/km_black">
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/km_campus_placeholder" android:scaleType="centerCrop" android:contentDescription="Illustrative campus map placeholder" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_gravity="center" android:gravity="center_horizontal">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="UCF · Main Campus" android:textSize="13sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginBottom="12dp" />
            <TextView android:layout_width="44dp" android:layout_height="44dp" android:text="16" android:textSize="16sp" android:textColor="@color/km_black" android:gravity="center" android:textStyle="bold" android:background="@drawable/km_marker" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_gravity="top" android:layout_margin="16dp">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_arrow_back" android:contentDescription="Back" app:tint="@color/km_text" android:id="@+id/back" android:padding="8dp" android:background="@drawable/km_circle" />
            <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center_vertical" android:layout_weight="1" android:background="@drawable/km_map_pill" android:paddingHorizontal="12dp" android:layout_marginStart="8dp">
                <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/km_location" android:contentDescription="Campus" app:tint="@color/km_gold" />
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="All listings" android:textSize="13sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_weight="1" android:layout_marginStart="8dp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="16" android:textSize="11sp" android:textColor="@color/km_gold" android:background="@drawable/km_gold_circle" android:padding="6dp" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Campus map placeholder" android:textSize="10sp" android:textColor="@color/km_text" android:layout_gravity="bottom|end" android:layout_margin="6dp" android:background="#CC0B0D0C" android:padding="4dp" />
    </FrameLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/km_divider" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/km_topbar">
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_home">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_search" android:contentDescription="Home" app:tint="@color/km_gold" android:padding="0dp" android:background="@android:color/transparent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Home" android:textSize="10sp" android:textColor="@color/km_gold" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_saved">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_favorite_border" android:contentDescription="Saved" app:tint="@color/km_muted" android:padding="0dp" android:background="@android:color/transparent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved" android:textSize="10sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_sell">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_add" android:contentDescription="Sell" app:tint="@color/km_black" android:padding="7dp" android:background="@drawable/km_marker" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sell" android:textSize="10sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_chats">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chat" android:contentDescription="Chats" app:tint="@color/km_muted" android:padding="0dp" android:background="@android:color/transparent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chats" android:textSize="10sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_you">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_person" android:contentDescription="You" app:tint="@color/km_muted" android:padding="0dp" android:background="@android:color/transparent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="You" android:textSize="10sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>