<?xml version='1.0' encoding='utf-8'?>
<!-- One of my listings (MyListingsActivity); same style as the original mockup cards -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/km_card" android:layout_marginBottom="12dp" android:id="@+id/myCard">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="10dp">
        <FrameLayout android:layout_width="72dp" android:layout_height="72dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/km_photo_placeholder">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/km_camera" android:contentDescription="Listing photo placeholder" app:tint="@color/km_muted" />
            </LinearLayout>
            <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/myImage" android:scaleType="centerCrop" android:contentDescription="Listing photo" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/myTitle" android:text="Black Ops Duffel Bag" android:textSize="14sp" android:textColor="@color/km_text" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:id="@+id/myMeta" android:text="$18 · Other" android:textSize="12sp" android:textColor="@color/km_muted" android:layout_marginTop="6dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:id="@+id/myStatus" android:text="● Available" android:textSize="11sp" android:textColor="@color/km_green" android:background="@drawable/km_available" android:paddingHorizontal="9dp" android:paddingVertical="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/km_divider" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center" android:layout_weight="1" android:id="@+id/myChangeStatus">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/km_edit" android:contentDescription="Change status" app:tint="@color/km_muted" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Change Status" android:textSize="12sp" android:textColor="@color/km_muted" android:layout_marginStart="6dp" />
        </LinearLayout>
        <View android:layout_width="1dp" android:layout_height="16dp" android:background="@color/km_divider" />
        <LinearLayout android:layout_width="0dp" android:layout_height="44dp" android:orientation="horizontal" android:gravity="center" android:layout_weight="1" android:id="@+id/myDelete">
            <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/km_delete" android:contentDescription="Delete" app:tint="#E56363" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Delete" android:textSize="12sp" android:textColor="#E56363" android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
