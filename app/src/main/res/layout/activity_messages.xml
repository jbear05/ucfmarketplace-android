<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/main" android:tag="reference_full_width" android:background="@color/km_black">
    <TextView android:layout_width="match_parent" android:layout_height="56dp" android:text="Messages" android:textSize="18sp" android:textColor="@color/km_text" android:textStyle="bold" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="@color/km_topbar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/conversation" android:padding="16dp" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="72dp" android:layout_height="72dp" android:orientation="vertical" android:gravity="center" android:background="@drawable/km_photo_placeholder">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/km_camera" android:contentDescription="Listing photo placeholder" app:tint="@color/km_muted" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clark Kent" android:textSize="15sp" android:textColor="@color/km_text" android:textStyle="bold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Black Ops Duffel Bag" android:textSize="12sp" android:textColor="@color/km_gold" android:layout_marginTop="4dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Best deal?" android:textSize="13sp" android:textColor="@color/km_text" android:layout_marginTop="5dp" />
                </LinearLayout>
                <LinearLayout android:layout_width="36dp" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="now" android:textSize="10sp" android:textColor="@color/km_gold" android:gravity="end" />
                    <TextView android:layout_width="20dp" android:layout_height="20dp" android:text="1" android:textSize="10sp" android:textColor="@color/km_black" android:layout_marginTop="16dp" android:layout_gravity="end" android:gravity="center" android:background="@drawable/km_unread" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/km_divider" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/km_topbar">
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_home">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_search" android:contentDescription="Home" app:tint="@color/km_muted" android:padding="0dp" android:background="@android:color/transparent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Home" android:textSize="10sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_saved">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_favorite_border" android:contentDescription="Saved" app:tint="@color/km_muted" android:padding="0dp" android:background="@android:color/transparent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Saved" android:textSize="10sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_sell">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_add" android:contentDescription="Sell" app:tint="@color/km_black" android:padding="7dp" android:background="@drawable/km_marker" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sell" android:textSize="10sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_chats">
            <FrameLayout android:layout_width="30dp" android:layout_height="26dp">
                <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_chat" android:contentDescription="Chats" app:tint="@color/km_gold" android:padding="0dp" android:background="@android:color/transparent" />
                <TextView android:layout_width="12dp" android:layout_height="12dp" android:text="1" android:textSize="8sp" android:textColor="@color/km_black" android:layout_gravity="top|end" android:gravity="center" android:background="@drawable/km_unread" />
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Chats" android:textSize="10sp" android:textColor="@color/km_gold" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="64dp" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:id="@+id/nav_you">
            <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_person" android:contentDescription="You" app:tint="@color/km_muted" android:padding="0dp" android:background="@android:color/transparent" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="You" android:textSize="10sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>