<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/main" android:tag="reference_full_width" android:background="@color/km_black">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="4dp" android:background="@color/km_topbar">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:contentDescription="Back" app:tint="@color/km_text" android:id="@+id/back" android:padding="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="List an Item" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Basic Info" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" />
                <EditText android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/listing_title" android:layout_marginTop="12dp" android:background="@drawable/km_input" android:padding="16dp" android:hint="Title *" android:textColor="@color/km_text" android:textColorHint="@color/km_muted" android:textSize="14sp" android:gravity="center_vertical" android:inputType="textCapSentences" />
                <EditText android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/price" android:layout_marginTop="12dp" android:background="@drawable/km_input" android:padding="16dp" android:hint="Price ($) *" android:textColor="@color/km_text" android:textColorHint="@color/km_muted" android:textSize="14sp" android:gravity="center_vertical" android:inputType="numberDecimal" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Category" android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="16dp" />
                <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="2dp" android:layout_marginTop="6dp">
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/category_0" android:text="Textbooks" android:checkable="true" android:checked="true" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/category_1" android:text="Electronics" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/category_2" android:text="Furniture" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/category_3" android:text="Clothing" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/category_4" android:text="Dorm &amp; Home" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/category_5" android:text="Tickets &amp; Events" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/category_6" android:text="Vehicles" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/category_7" android:text="Other" android:checkable="true" android:checked="false" />
                </com.google.android.material.chip.ChipGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Campus" android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="16dp" />
                <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="2dp" android:layout_marginTop="6dp">
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/campus_0" android:text="Main Campus" android:checkable="true" android:checked="true" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/campus_1" android:text="Rosen Campus" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/campus_2" android:text="Downtown Campus" android:checkable="true" android:checked="false" />
                </com.google.android.material.chip.ChipGroup>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Condition" android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="16dp" />
                <com.google.android.material.chip.ChipGroup android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="6dp" app:chipSpacingVertical="2dp" android:layout_marginTop="6dp">
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/condition_0" android:text="New" android:checkable="true" android:checked="true" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/condition_1" android:text="Like New" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/condition_2" android:text="Good" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/condition_3" android:text="Fair" android:checkable="true" android:checked="false" />
                    <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" style="@style/KmChip" android:id="@+id/condition_4" android:text="Poor" android:checkable="true" android:checked="false" />
                </com.google.android.material.chip.ChipGroup>
                <EditText android:layout_width="match_parent" android:layout_height="120dp" android:id="@+id/description" android:layout_marginTop="12dp" android:background="@drawable/km_input" android:padding="16dp" android:hint="Description" android:textColor="@color/km_text" android:textColorHint="@color/km_muted" android:textSize="14sp" android:gravity="top|start" android:inputType="textMultiLine" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                    <CheckBox android:layout_width="48dp" android:layout_height="48dp" android:id="@+id/ai_generated" android:contentDescription="Tag as AI-generated" app:buttonTint="@color/km_muted" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tag as AI-generated" android:textSize="13sp" android:textColor="@color/km_text" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Required for AI-generated artwork or prints" android:textSize="11sp" android:textColor="@color/km_muted" android:layout_marginTop="3dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="24dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Photos" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0/8" android:textSize="12sp" android:textColor="@color/km_muted" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Max 8 photos. Tap a photo to set it as cover." android:textSize="11sp" android:textColor="@color/km_muted" android:layout_marginTop="4dp" />
                <LinearLayout android:layout_width="80dp" android:layout_height="80dp" android:orientation="vertical" android:id="@+id/add_photo" android:gravity="center" android:background="@drawable/km_card" android:layout_marginTop="12dp" android:clickable="true" android:focusable="true">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/km_camera" android:contentDescription="Add photos" app:tint="@color/km_gold" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add" android:textSize="11sp" android:textColor="@color/km_gold" android:gravity="center" android:layout_marginTop="6dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/publish" android:text="Publish Listing" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/km_black" app:backgroundTint="@color/km_gold" app:cornerRadius="8dp" android:layout_marginTop="24dp" android:layout_marginBottom="24dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>