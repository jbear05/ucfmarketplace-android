<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/main" android:tag="reference_full_width" android:background="@color/km_black">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="4dp" android:background="@color/km_topbar">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back" android:contentDescription="Back" app:tint="@color/km_text" android:id="@+id/back" android:padding="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Community Rules" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="KnightMarket only works if everyone on it can trust everyone else. These are the rules every account agrees to at signup." android:textSize="13sp" android:textColor="@color/km_muted" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Verified Knights only" android:textSize="14sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_marginTop="20dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Every account is tied to a real @ucf.edu or @knights.ucf.edu address. Don’t create an account on someone else’s behalf or share your login." android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Real photos, honest listings" android:textSize="14sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_marginTop="20dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Photograph the actual item you’re selling — no stock photos or images pulled from the internet. Describe the condition accurately, flaws included." android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Meet safely, on campus, in public" android:textSize="14sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_marginTop="20dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Arrange meetups in public, well-trafficked campus areas. Don’t invite buyers or sellers to a private residence, and don’t agree to meet off campus at night." android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Be straight about price" android:textSize="14sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_marginTop="20dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="The price on the listing is the price you honor. Don’t bait someone into a meetup and then raise the price." android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Respectful communication" android:textSize="14sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_marginTop="20dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No harassment, threats, or discriminatory language in listings, chat, or meetups — with fellow students or with the KnightMarket team." android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="What happens if you break these" android:textSize="14sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_marginTop="20dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reported violations are reviewed by an admin. Depending on severity, that can mean a listing being taken down or the account being suspended." android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="6dp" android:lineSpacingExtra="4dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>