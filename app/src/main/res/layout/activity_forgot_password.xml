<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/main" android:tag="reference_full_width" android:background="@color/km_black">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="4dp" android:background="@color/km_topbar">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_arrow_back" android:contentDescription="Back" app:tint="@color/km_text" android:id="@+id/back" android:padding="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset Password" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Forgot your password?" android:textSize="22sp" android:textColor="@color/km_text" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Enter your email and we’ll send you a reset link." android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="8dp" />
                <EditText android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/email" android:layout_marginTop="12dp" android:background="@drawable/km_input" android:padding="16dp" android:hint="Email address" android:textColor="@color/km_text" android:textColorHint="@color/km_muted" android:textSize="14sp" android:gravity="center_vertical" android:inputType="textEmailAddress" />
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/reset" android:text="Send Reset Link" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/km_black" app:backgroundTint="@color/km_gold" app:cornerRadius="8dp" android:layout_marginTop="16dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>