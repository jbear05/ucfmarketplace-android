<?xml version="1.0" encoding="utf-8"?>
<!-- One card in the Shopping grid; same style as the original mockup cards -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/listingCard"
    android:layout_width="match_parent"
    android:layout_height="220dp"
    android:layout_margin="8dp"
    android:background="@drawable/product_card_bg">

    <FrameLayout
        android:id="@+id/listingImageFrame"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:background="@drawable/product_image_placeholder"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="PHOTO"
            android:textColor="#C7BFA4"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.2"/>
        <ImageView
            android:id="@+id/listingImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Listing photo"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/listingPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        android:text="$540"
        android:textColor="@color/text_main"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingImageFrame" />

    <TextView
        android:id="@+id/listingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="2dp"
        android:text="MacBook Air M1 · 256 GB"
        android:textColor="@color/text_main"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end"
        app:layout_constraintTop_toBottomOf="@+id/listingPrice" />

    <TextView
        android:id="@+id/listingTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/condition_tag_green_bg"
        android:paddingHorizontal="6dp"
        android:paddingVertical="2dp"
        android:text="Like new"
        android:textColor="@color/banner_green_text"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/listingTitle" />

    <ImageView
        android:id="@+id/listingStar"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_star"
        app:layout_constraintBottom_toBottomOf="@+id/listingTag"
        app:layout_constraintStart_toEndOf="@+id/listingTag"
        app:layout_constraintTop_toTopOf="@+id/listingTag" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:id="@+id/listingRating"
        android:text="4.9"
        android:textColor="@color/text_main"
        android:textSize="10sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/listingTag"
        app:layout_constraintStart_toEndOf="@+id/listingTag"
        app:layout_constraintTop_toTopOf="@+id/listingTag" />
</androidx.constraintlayout.widget.ConstraintLayout>
