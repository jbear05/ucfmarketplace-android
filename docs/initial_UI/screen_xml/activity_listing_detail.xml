<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/main" android:tag="reference_full_width" android:background="@color/km_black">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:layout_width="match_parent" android:layout_height="260dp">
                <FrameLayout android:layout_width="match_parent" android:layout_height="260dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/km_photo_placeholder">
                        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/km_camera" android:contentDescription="Item photo placeholder" app:tint="@color/km_muted" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PHOTO" android:textSize="11sp" android:textColor="@color/km_muted" android:gravity="center" android:letterSpacing="0.18" android:layout_marginTop="10dp" />
                    </LinearLayout>
                </FrameLayout>
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_arrow_back" android:contentDescription="Back" app:tint="@color/km_text" android:id="@+id/back" android:padding="8dp" android:background="@drawable/km_circle" android:layout_gravity="top|start" android:layout_margin="12dp" />
                <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_favorite_border" android:contentDescription="Save listing" app:tint="@color/km_text" android:id="@+id/favorite" android:padding="8dp" android:background="@drawable/km_circle" android:layout_gravity="top|end" android:layout_margin="12dp" />
            </FrameLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="$24" android:textSize="26sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_weight="1" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● Available" android:textSize="11sp" android:textColor="@color/km_green" android:background="@drawable/km_available" android:paddingHorizontal="9dp" android:paddingVertical="4dp" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tactical Utility Belt" android:textSize="20sp" android:textColor="@color/km_text" android:textStyle="bold" android:layout_marginTop="8dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp">
                    <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/km_location" android:contentDescription="Campus" app:tint="@color/km_muted" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="Main Campus" android:textSize="12sp" android:textColor="@color/km_muted" android:layout_weight="1" android:layout_marginStart="4dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Posted 4d ago" android:textSize="11sp" android:textColor="@color/km_muted" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="↗ Get Directions" android:textSize="12sp" android:textColor="@color/km_gold" android:id="@+id/directions" android:layout_marginTop="6dp" android:paddingVertical="4dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/km_divider" android:layout_marginVertical="16dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Item Details" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="12dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:padding="16dp" android:background="@drawable/km_card">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_home" android:contentDescription="Category" app:tint="@color/km_text" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Clothing" android:textSize="13sp" android:textColor="@color/km_text" android:textStyle="bold" android:gravity="center" android:layout_marginTop="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Category" android:textSize="11sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
                    </LinearLayout>
                    <Space android:layout_width="8dp" android:layout_height="1dp" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:gravity="center" android:padding="16dp" android:background="@drawable/km_card">
                        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_star" android:contentDescription="Condition" app:tint="@color/km_gold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Good" android:textSize="13sp" android:textColor="@color/km_gold" android:textStyle="bold" android:gravity="center" android:layout_marginTop="6dp" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Condition" android:textSize="11sp" android:textColor="@color/km_muted" android:gravity="center" android:layout_marginTop="3dp" />
                    </LinearLayout>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/km_divider" android:layout_marginVertical="16dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="About this item" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Adjustable, multiple pouches. Costume/cosplay grade." android:textSize="13sp" android:textColor="@color/km_muted" android:layout_marginTop="8dp" android:lineSpacingExtra="4dp" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/km_divider" android:layout_marginVertical="16dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Listed by" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/seller" android:background="@drawable/km_card" android:padding="12dp" android:layout_marginTop="8dp" android:clickable="true" android:focusable="true">
                    <TextView android:layout_width="44dp" android:layout_height="44dp" android:text="G" android:textSize="18sp" android:textColor="@color/km_gold" android:gravity="center" android:textStyle="bold" android:background="@drawable/km_gold_circle" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:layout_weight="1" android:layout_marginStart="12dp">
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Gaspar Dantas" android:textSize="14sp" android:textColor="@color/km_text" android:textStyle="bold" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Verified Knight" android:textSize="11sp" android:textColor="@color/km_green" android:layout_marginTop="4dp" />
                    </LinearLayout>
                    <TextView android:layout_width="20dp" android:layout_height="wrap_content" android:text="›" android:textSize="24sp" android:textColor="@color/km_muted" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/contact" android:text="Contact Seller" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/km_black" app:backgroundTint="@color/km_gold" app:cornerRadius="8dp" app:icon="@drawable/ic_chat" app:iconTint="@color/km_black" app:iconGravity="textStart" />
    </LinearLayout>
</LinearLayout>