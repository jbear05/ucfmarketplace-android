<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:id="@+id/main" android:tag="reference_full_width" android:background="@color/km_black">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="4dp" android:background="@color/km_topbar">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:contentDescription="Back to screen picker" app:tint="@color/km_text" android:id="@+id/back" android:padding="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Arrange Meetup" android:textSize="16sp" android:textColor="@color/km_text" android:textStyle="bold" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pick a public campus spot to meet — these are all vetted, well-trafficked locations." android:textSize="13sp" android:textColor="@color/km_muted" android:lineSpacingExtra="4dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Meetup spot" android:textSize="12sp" android:textColor="@color/km_muted" android:layout_marginTop="20dp" />
                <FrameLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp">
                    <Spinner android:layout_width="match_parent" android:layout_height="match_parent" android:id="@+id/meetup_spot" android:entries="@array/km_meetup_spots" android:background="@drawable/km_input" android:paddingHorizontal="12dp" android:popupBackground="@color/km_surface" android:spinnerMode="dropdown" />
                    <TextView android:layout_width="32dp" android:layout_height="match_parent" android:text="⌄" android:textSize="20sp" android:textColor="@color/km_muted" android:layout_gravity="end" android:gravity="center" android:layout_marginEnd="8dp" />
                </FrameLayout>
                <EditText android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/meetup_detail" android:layout_marginTop="12dp" android:background="@drawable/km_input" android:padding="16dp" android:hint="Extra detail (optional)" android:textColor="@color/km_text" android:textColorHint="@color/km_muted" android:textSize="14sp" android:gravity="center_vertical" android:inputType="textCapSentences" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal" android:gravity="center_vertical" android:id="@+id/meetup_date" android:paddingHorizontal="16dp" android:background="@drawable/km_input" android:layout_marginTop="12dp">
                    <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/km_calendar" android:contentDescription="Date and time" app:tint="@color/km_muted" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pick a date &amp; time (optional)" android:textSize="13sp" android:textColor="@color/km_text" android:layout_marginStart="10dp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:layout_width="match_parent" android:layout_height="52dp" android:id="@+id/propose_meetup" android:text="Propose This Meetup" android:textSize="14sp" android:textAllCaps="false" android:textColor="@color/km_black" app:backgroundTint="@color/km_gold" app:cornerRadius="8dp" android:layout_marginTop="20dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>